<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/teamsintegration/db" VERSION="2025111300" COMMENT="XMLDB file for teamsintegration module"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>

    <TABLE NAME="teamsintegration" COMMENT="Stores Teams meetings for courses">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" SEQUENCE="true" NOTNULL="true" COMMENT="Primary key"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" COMMENT="Meeting name"/>
        <FIELD NAME="meetingid" TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="Teams meeting ID"/>
        <FIELD NAME="joinurl" TYPE="text" NOTNULL="false" COMMENT="Teams meeting join URL"/>
        <FIELD NAME="starttime" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Meeting start timestamp"/>
        <FIELD NAME="endtime" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Meeting end timestamp"/>
        <!-- standard intro fields added so description can be stored -->
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" COMMENT="Activity description"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" COMMENT="Description format"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Record creation time"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" COMMENT="Last modified time"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="teamsintegration_attendance" COMMENT="Tracks attendance for Teams meetings">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" SEQUENCE="true" NOTNULL="true" COMMENT="Primary key"/>
        <FIELD NAME="meetingid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Related meeting ID"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="Moodle user ID"/>
        <FIELD NAME="email" TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="User email"/>
        <FIELD NAME="addedat" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="Timestamp when attendee was added"/>
        <FIELD NAME="jointime" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="Join timestamp"/>
        <FIELD NAME="leavetime" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="Leave timestamp"/>
        <FIELD NAME="duration" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="Attendance duration in seconds"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>

  </TABLES>
</XMLDB>
